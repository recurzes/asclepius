<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.0" />
    <PackageReference Include="OpenCvSharp4.Windows" Version="4.13.0.20260627" />
    <PackageReference Include="OpenCvSharp4.WpfExtensions" Version="4.13.0.20260627" />
    <PackageReference Include="System.IO.Ports" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\models\asclepius_bcc.onnx" Link="asclepius_bcc.onnx" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
