<Window x:Class="desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="ASCLEPIUS" Height="720" Width="1000" Closing="Window_Closing">
    <DockPanel>
        <WrapPanel DockPanel.Dock="Top" Margin="8">
            <Button x:Name="CameraButton" Content="Start camera" Click="Camera_Click" Padding="12,4"/>
            <ComboBox x:Name="CameraIndex" SelectedIndex="0" Margin="4,0" Width="44" ToolTip="Camera number">
                <sys:Int32>0</sys:Int32>
                <sys:Int32>1</sys:Int32>
                <sys:Int32>2</sys:Int32>
                <sys:Int32>3</sys:Int32>
            </ComboBox>
            <Button Content="Open image..." Click="OpenImage_Click" Padding="12,4" Margin="8,0"/>

            <TextBlock Text="Min confidence" VerticalAlignment="Center" Margin="16,0,4,0"/>
            <Slider x:Name="MinScore" Minimum="0.25" Maximum="0.99" Value="0.50" Width="120"
                    VerticalAlignment="Center" SmallChange="0.01" LargeChange="0.05"/>
            <TextBlock Text="{Binding Value, ElementName=MinScore, StringFormat=0.00}" VerticalAlignment="Center" Width="34" Margin="4,0"/>

            <TextBlock Text="Arduino" VerticalAlignment="Center" Margin="16,0,4,0"/>
            <ComboBox x:Name="PortBox" Width="80" DropDownOpened="PortBox_DropDownOpened"/>
            <Button x:Name="ConnectButton" Content="Connect" Click="Connect_Click" Padding="12,4" Margin="4,0"/>
        </WrapPanel>

        <TextBox x:Name="Log" DockPanel.Dock="Bottom" Height="140" IsReadOnly="True" FontFamily="Consolas"
                 VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Margin="8"/>

        <Image x:Name="View" Stretch="Uniform" Margin="8"/>
    </DockPanel>
</Window>
