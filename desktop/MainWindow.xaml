<Window x:Class="desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ASCLEPIUS · BCC Screening" Height="780" Width="1200" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="{StaticResource AppBg}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" Foreground="{StaticResource Ink}"
        UseLayoutRounding="True" Closing="Window_Closing">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= sidebar ================= -->
        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,20,12,8">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}"/>
                </ScrollViewer.Resources>
                <StackPanel>

                    <!-- brand -->
                    <DockPanel Margin="2,0,0,22">
                        <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource Accent}" Margin="0,0,12,0">
                            <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE95E;" FontSize="18" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ASCLEPIUS" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="Basal cell carcinoma screening" FontSize="12" Foreground="{StaticResource InkMuted}"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- source -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="SOURCE" Style="{StaticResource SectionLabel}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="104"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="CameraIndex" SelectedIndex="0" ToolTip="Which camera to use" AutomationProperties.Name="Camera">
                                    <ComboBoxItem Content="Camera 0"/>
                                    <ComboBoxItem Content="Camera 1"/>
                                    <ComboBoxItem Content="Camera 2"/>
                                    <ComboBoxItem Content="Camera 3"/>
                                </ComboBox>
                                <Button x:Name="CameraButton" Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Click="Camera_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="CameraButtonIcon" FontFamily="{StaticResource Icons}" Text="&#xE768;" FontSize="12"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="CameraButtonText" Text="Start camera" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Button Margin="0,8,0,0" Style="{StaticResource SecondaryButton}" Click="OpenImage_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE8B9;" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Open image…" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="You can also drag an image onto the viewer." Style="{StaticResource Hint}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- detection -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="DETECTION" Style="{StaticResource SectionLabel}"/>
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Background="{StaticResource AccentSoft}" CornerRadius="4" Padding="8,2">
                                    <TextBlock Text="{Binding Value, ElementName=MinScore, StringFormat=0.00}" FontWeight="SemiBold"
                                               Foreground="{StaticResource Accent}" FontFamily="Cascadia Mono, Consolas"/>
                                </Border>
                                <TextBlock Text="Minimum confidence" Style="{StaticResource FieldLabel}"/>
                            </DockPanel>
                            <Slider x:Name="MinScore" Minimum="0.25" Maximum="0.99" Value="0.50" SmallChange="0.01" LargeChange="0.05"
                                    Margin="0,8,0,2" AutomationProperties.Name="Minimum confidence"/>
                            <TextBlock Text="Lower values catch more lesions but raise more false alarms." Style="{StaticResource Hint}"/>

                            <Border x:Name="ResultCard" CornerRadius="8" Padding="14,12" Margin="0,14,0,0" Background="{StaticResource IdleBg}">
                                <DockPanel>
                                    <TextBlock x:Name="ResultIcon" FontFamily="{StaticResource Icons}" Text="&#xE9D9;" FontSize="22"
                                               Foreground="{StaticResource IdleFg}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="ResultTitle" Text="Waiting for an image" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{StaticResource IdleFg}"/>
                                        <TextBlock x:Name="ResultDetail" Text="Results appear here." FontSize="12"
                                                   Foreground="{StaticResource InkMuted}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- alerts -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="SMS ALERTS" Style="{StaticResource SectionLabel}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="PortBox" DropDownOpened="PortBox_DropDownOpened" ToolTip="Arduino COM port"
                                          AutomationProperties.Name="Arduino port"/>
                                <Button x:Name="ConnectButton" Grid.Column="1" Content="Connect" Margin="8,0,0,0" MinWidth="96"
                                        Style="{StaticResource SecondaryButton}" Click="Connect_Click"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="2,12,0,0">
                                <Ellipse x:Name="ArduinoDot" Width="8" Height="8" Fill="{StaticResource InkFaint}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ArduinoStatus" Text="Arduino not connected" Margin="8,0,0,0" FontWeight="SemiBold"
                                           Foreground="{StaticResource InkMuted}"/>
                            </StackPanel>
                            <TextBlock x:Name="LastAlert" Text="No alerts sent yet." Style="{StaticResource Hint}" Margin="18,4,0,0"/>
                            <TextBlock Text="The Arduino sends at most one SMS every 10 minutes." Style="{StaticResource Hint}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- log -->
                    <ToggleButton x:Name="LogToggle" Style="{StaticResource DisclosureToggle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE81C;" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Activity log" FontWeight="SemiBold"/>
                        </StackPanel>
                    </ToggleButton>
                    <Border Visibility="{Binding IsChecked, ElementName=LogToggle, Converter={StaticResource BoolToVis}}"
                            Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                            CornerRadius="8" Padding="4" Margin="0,6,0,12">
                        <TextBox x:Name="Log" Height="190" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                 Foreground="{StaticResource InkMuted}" FontFamily="Cascadia Mono, Consolas" FontSize="11.5"
                                 VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Padding="4"/>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ================= viewer ================= -->
        <Border Grid.Column="1" Background="{StaticResource Stage}" AllowDrop="True" Drop="Stage_Drop">
            <Grid>
                <Image x:Name="View" Stretch="Uniform" Margin="24" RenderOptions.BitmapScalingMode="HighQuality"/>

                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="340">
                    <Border Width="72" Height="72" CornerRadius="36" Background="#1E2630" HorizontalAlignment="Center">
                        <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE722;" FontSize="28" Foreground="{StaticResource StageInk}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="No image yet" Foreground="#E6EAEE" FontSize="17" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,18,0,6"/>
                    <TextBlock Text="Start the camera or open an image of a skin lesion. You can also drop an image file here."
                               Foreground="{StaticResource StageInk}" TextAlignment="Center" TextWrapping="Wrap" LineHeight="20"/>
                </StackPanel>

                <Border x:Name="SourceBadge" Visibility="Collapsed" Background="#B3000000" CornerRadius="13" Padding="10,5"
                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="LiveDot" Width="8" Height="8" Fill="#F04438" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="SourceText" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ================= status bar ================= -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                BorderThickness="0,1,0,0" Padding="16,7">
            <DockPanel>
                <TextBlock x:Name="StatusRight" DockPanel.Dock="Right" Text="Idle" Foreground="{StaticResource InkFaint}" FontSize="12"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE946;" FontSize="12" Foreground="{StaticResource InkFaint}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Screening aid only, not a diagnosis. Refer suspicious lesions to a dermatologist."
                               Foreground="{StaticResource InkMuted}" FontSize="12"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
